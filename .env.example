# ---- App ----
APP_NAME="SENTRA 360"
APP_TAGLINE="Your security company. Your brand. One connected security platform."
# development | production  (development shows error details and the Developer Outbox)
APP_ENV=development
# The address people use to open the app (used in email links)
APP_URL=http://localhost:8360
# Long random string; used to protect verification codes and links
APP_KEY=change-me-to-a-long-random-string

# ---- The company (used once, when bin/install.php first runs) ----
# After installation, change name, logo, colours and contacts in Admin -> Branding.
COMPANY_NAME="SENTRA 360 Security"
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_EMERGENCY_PHONE=
COMPANY_PSIRA=
COMPANY_PRIMARY_COLOR=#0B3D91
COMPANY_SECONDARY_COLOR=#111827

# ---- First Admin login (created by bin/install.php) ----
ADMIN_EMAIL=admin@company.local
ADMIN_MOBILE=0820000000
ADMIN_PASSWORD=ChangeMe!Admin360

# ---- Database ----
DB_HOST=db
DB_PORT=3306
DB_NAME=sentra360
DB_USER=sentra
DB_PASS=sentra_dev_pass
DB_ROOT_PASS=sentra_root_dev

# ---- Email delivery. Empty = NOT configured: emails are recorded but NOT sent ----
MAIL_PROVIDER=
MAIL_FROM=no-reply@company.local

# ---- SMS / OTP delivery. Empty = NOT configured: SMS are recorded but NOT sent ----
SMS_PROVIDER=
